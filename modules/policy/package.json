{
  "name": "@hrms/module-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Policy engine: typed policies with effective-dated versions, OU applicability, priority and per-employee overrides.",
  "hrms": { "kind": "module" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@hrms/contracts": "workspace:*", "@hrms/db": "workspace:*", "@hrms/domain": "workspace:*", "@hrms/module-sdk": "workspace:*", "@hrms/platform": "workspace:*", "zod": "4.6.5" }
}
