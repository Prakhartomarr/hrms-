{
  "name": "@hrms/module-people",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Employee master: profile sections, custom fields, effective-dated job history, masking, Excel import and export.",
  "hrms": { "kind": "module" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@hrms/contracts": "workspace:*", "@hrms/db": "workspace:*", "@hrms/domain": "workspace:*", "@hrms/module-sdk": "workspace:*", "@hrms/platform": "workspace:*", "zod": "4.6.5", "exceljs": "4.4.0" }
}
