{
  "name": "@hrms/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-cutting runtime: config, logging, execution context, tenant DB, auth tokens, TOTP, the central access guard, audit log, outbox, jobs, rate limits, mail, file storage, shutdown.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@hrms/contracts": "workspace:*", "@hrms/db": "workspace:*", "@hrms/domain": "workspace:*", "bullmq": "5.81.5", "ioredis": "5.11.1", "jose": "6.2.12", "kysely": "0.28.17", "pino": "9.14.0", "pino-pretty": "13.2.0", "zod": "4.6.5" }
}
