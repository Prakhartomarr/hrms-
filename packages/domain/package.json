{
  "name": "@hrms/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure HR engines: access grants and data scope, policy resolution, effective-dated job history, code series, masking, field diffs, custom-field validation.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@hrms/contracts": "workspace:*" }
}
