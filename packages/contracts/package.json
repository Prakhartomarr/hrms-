{
  "name": "@hrms/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared zod schemas and types: primitives, India validators and formatting, the access model, and every HTTP API request/response.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "zod": "4.6.5" }
}
