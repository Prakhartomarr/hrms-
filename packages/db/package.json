{
  "name": "@hrms/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres (Kysely) client, core schema types, migrations runner and core migrations (tenancy, org, employees, roles, audit).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hrms/contracts": "workspace:*",
    "kysely": "0.28.17",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
