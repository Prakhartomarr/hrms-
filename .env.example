# Copy to .env (make up does this for you). Every setting is an env var (12-factor).

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# HTTP
API_HOST=0.0.0.0
API_PORT=4100
CORS_ORIGINS=http://localhost:5180
# Proxies in front of the API: false (none), a hop count, or addresses/CIDRs.
TRUST_PROXY=false
# Web app origin, used to build links in emails (password reset).
WEB_URL=http://localhost:5180

# Postgres. DATABASE_URL is the runtime role: row-level security applies.
# DATABASE_ADMIN_URL owns the schema: migrations and platform internals only.
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms
POSTGRES_DB=hrms
APP_DB_USER=hrms_app
APP_DB_PASSWORD=hrms_app
DATABASE_URL=postgres://hrms_app:hrms_app@localhost:5433/hrms
DATABASE_ADMIN_URL=postgres://hrms:hrms@localhost:5433/hrms
DATABASE_POOL_MAX=10

# Redis (job queue, rate limits)
REDIS_URL=redis://localhost:6380

# Auth and secrets (generate real values outside local dev)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ISSUER=hrms
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

# Email. Unset SMTP_URL: emails are written to the log. Local: Mailpit (UI http://localhost:8026).
SMTP_URL=smtp://localhost:1026
MAIL_FROM=HRMS <no-reply@localhost>

# Single sign-on (stubs). Set a client id to show the provider on the sign-in page.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# SSO_REDIRECT_URL=http://localhost:4100/api/v1/auth/sso/callback

# Jobs
WORKER_CONCURRENCY=4
RATE_LIMIT_PER_MINUTE=600

# Optional: comma-separated module ids to skip at boot
DISABLED_MODULES=
